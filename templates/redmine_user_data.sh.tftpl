#!/bin/bash
# Redmine EC2 初期化スクリプト (初回起動時のみ実行)
set -euxo pipefail
exec > >(tee /var/log/redmine-setup.log) 2>&1

APP_DIR=/opt/redmine
DATA_DIR=/data

################################################################################
# パッケージ
################################################################################
# インターネットへの経路はなく、以下はすべて VPC エンドポイント経由
#  - dnf            : S3 ゲートウェイエンドポイント
#  - Docker Compose : S3 ゲートウェイエンドポイント
#  - Docker イメージ : ECR (プルスルーキャッシュ) インターフェイスエンドポイント
#  - シークレット    : SSM インターフェイスエンドポイント
# インターフェイスエンドポイントは常設せず、EC2 の新規起動を検知した Lambda が作成する
dnf install -y docker amazon-ecr-credential-helper
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
aws s3 cp --region "${region}" "${docker_compose_s3_uri}" /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# ECR の認証は credential helper が自動で行う (トークン期限切れの心配なし)
mkdir -p /root/.docker
cat > /root/.docker/config.json <<'JSON'
{ "credHelpers": { "${ecr_registry}": "ecr-login" } }
JSON

################################################################################
# スワップ (メモリ 2GB 環境での OOM 対策)
################################################################################
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  echo '/swapfile none swap defaults 0 0' >> /etc/fstab
fi
swapon -a

################################################################################
# データボリューム
################################################################################
DEV=/dev/disk/by-id/${data_volume_devname}
for i in $(seq 1 60); do
  [ -e "$DEV" ] && break
  echo "waiting for data volume... ($i)"
  sleep 5
done
[ -e "$DEV" ]

if ! blkid "$DEV" >/dev/null 2>&1; then
  mkfs.xfs "$DEV"
fi

mkdir -p "$DATA_DIR"
UUID=$(blkid -s UUID -o value "$DEV")
if ! grep -q "$UUID" /etc/fstab; then
  echo "UUID=$UUID $DATA_DIR xfs defaults,nofail 0 2" >> /etc/fstab
fi
systemctl daemon-reload
mount -a

mkdir -p "$DATA_DIR"/{postgres,redmine/files,redmine/plugins}

################################################################################
# インターフェイスエンドポイントの準備完了を待つ
# (Lambda が起動イベントを受けて作成するまで 2〜5 分程度かかる)
################################################################################
wait_for() {
  local name=$1
  shift
  for i in $(seq 1 90); do
    if "$@" >/dev/null 2>&1; then
      echo "$name endpoint is ready"
      return 0
    fi
    echo "waiting for $name endpoint... ($i)"
    sleep 10
  done
  echo "$name endpoint is not available" >&2
  return 1
}

wait_for ssm aws ssm get-parameter --region "${region}" --cli-connect-timeout 5 \
  --name "${db_password_param}" --with-decryption
wait_for ecr aws ecr get-authorization-token --region "${region}" --cli-connect-timeout 5

################################################################################
# シークレット (以降は .env を参照するため、再起動時に Parameter Store は不要)
################################################################################
get_param() {
  aws ssm get-parameter --region "${region}" --with-decryption \
    --name "$1" --query Parameter.Value --output text
}

DB_PASSWORD=$(get_param "${db_password_param}")
SECRET_KEY_BASE=$(get_param "${secret_key_base_param}")

mkdir -p "$APP_DIR"
umask 077
cat > "$APP_DIR/.env" <<ENV
DB_PASSWORD=$DB_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
ENV
umask 022

################################################################################
# docker compose
################################################################################
cat > "$APP_DIR/compose.yml" <<'YAML'
services:
  db:
    image: ${postgres_image}
    restart: unless-stopped
    environment:
      POSTGRES_USER: redmine
      POSTGRES_PASSWORD: $${DB_PASSWORD}
      POSTGRES_DB: redmine
    volumes:
      - /data/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U redmine"]
      interval: 10s
      timeout: 5s
      retries: 10
    logging: &logging
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  redmine:
    image: ${redmine_image}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      REDMINE_DB_POSTGRES: db
      REDMINE_DB_USERNAME: redmine
      REDMINE_DB_PASSWORD: $${DB_PASSWORD}
      REDMINE_DB_DATABASE: redmine
      REDMINE_SECRET_KEY_BASE: $${SECRET_KEY_BASE}
    volumes:
      - /data/redmine/files:/usr/src/redmine/files
      - /data/redmine/plugins:/usr/src/redmine/plugins
    logging: *logging

  nginx:
    image: ${nginx_image}
    restart: unless-stopped
    depends_on:
      - redmine
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    logging: *logging
YAML

# CloudFront で TLS 終端するため、Redmine には https としてリクエストを渡す
# (Rails の CSRF Origin チェック / リダイレクト URL を正しくするため)
cat > "$APP_DIR/nginx.conf" <<'NGINX'
server {
    listen 80 default_server;
    client_max_body_size ${upload_max_size_mb}m;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass         http://redmine:3000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
}
NGINX

cd "$APP_DIR"
# イメージはここで EC2 に保存されるため、以降の再起動ではエンドポイント不要
for i in $(seq 1 10); do
  docker compose pull && break
  echo "retrying docker compose pull... ($i)"
  sleep 15
done
docker compose up -d

################################################################################
# OS 自動セキュリティ更新 (毎日)
################################################################################
cat > /etc/systemd/system/dnf-security-upgrade.service <<'UNIT'
[Unit]
Description=dnf security upgrade

[Service]
Type=oneshot
ExecStart=/usr/bin/dnf upgrade -y --security --releasever=latest
UNIT

cat > /etc/systemd/system/dnf-security-upgrade.timer <<'UNIT'
[Unit]
Description=Daily dnf security upgrade

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now dnf-security-upgrade.timer

echo "Redmine setup completed."
