project = "redmine"
region  = "ap-northeast-1"

# EC2 サイズ (10 人以下なら t4g.small 推奨)
instance_type    = "t4g.small"
data_volume_size = 20

# 社内 / 自宅などの固定 IP からのみアクセスを許可する場合 (推奨)
# allowed_ip_cidrs = ["203.0.113.0/24"]

# 独自ドメインを使う場合 (ACM 証明書は us-east-1 で発行)
# custom_domain       = "redmine.example.com"
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx"
# route53_zone_id     = "Z0123456789ABCDEFGHIJ"

# 平日 8:00-21:00 のみ稼働させてコスト削減する場合
# enable_schedule = true

# バックアップ保持世代数
# backup_retain_count = 7
